PORT=3001
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=beaken
DB_USER=postgres
DB_PASSWORD=

# Firma de las sesiones (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Mercado Pago (Checkout Pro, credenciales de PRUEBA)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Correo (SMTP). Para pruebas: el buzón de Mailtrap (Email Testing > Integration > SMTP).
# Si faltan MAIL_HOST, MAIL_USER o MAIL_PASSWORD, no se envían correos (la app funciona igual).
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Beaken <no-reply@beaken.demo>"
